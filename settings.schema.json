{
  "version": 1,
  "description": "Reads exact merge requests using glab. No model calls. Authentication remains in glab.",
  "fields": [
    {
      "key": "host",
      "label": "GitLab hostname",
      "type": "string",
      "required": true,
      "description": "Hostname only, for example gitlab.example.com."
    },
    {
      "key": "executable",
      "label": "glab executable",
      "type": "string",
      "default": "glab"
    },
    {
      "key": "intervalSeconds",
      "label": "Polling interval (seconds)",
      "type": "integer",
      "default": 300,
      "minimum": 60,
      "maximum": 86400
    },
    {
      "key": "timeoutSeconds",
      "label": "Read timeout (seconds)",
      "type": "integer",
      "default": 90,
      "minimum": 5,
      "maximum": 600
    },
    {
      "key": "maxPages",
      "label": "Maximum pages",
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    }
  ]
}
